{
  "displayName": "Balance Laboral - consultarConvenio 5xx errors",
  "documentation": {
    "content": "Detecta mas de 3 respuestas 5xx en 10 minutos en la Cloud Function Gen2 consultarConvenio, expuesta como servicio Cloud Run consultarconvenio. Umbral prudente para trafico actual bajo: evita ruido por errores aislados, pero alerta ante fallos repetidos.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "app": "balance-laboral",
    "service": "consultarconvenio",
    "severity": "warning",
    "managed_by": "repo"
  },
  "conditions": [
    {
      "displayName": "consultarconvenio: mas de 3 errores 5xx en 10 minutos",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"consultarconvenio\" metric.labels.response_code_class=\"5xx\"",
        "aggregations": [
          {
            "alignmentPeriod": "600s",
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 3,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "combiner": "OR",
  "enabled": true,
  "alertStrategy": {
    "autoClose": "3600s"
  }
}
