{
  "displayName": "Balance Laboral - consultarConvenio p95 latency",
  "documentation": {
    "content": "Detecta latencia p95 superior a 10 segundos sostenida durante 10 minutos en consultarConvenio. Es prudente para una ruta con IA/RAG porque algunas respuestas pueden tardar, pero mas de 10 s sostenidos indica degradacion real o saturacion.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "app": "balance-laboral",
    "service": "consultarconvenio",
    "severity": "warning",
    "managed_by": "repo"
  },
  "conditions": [
    {
      "displayName": "consultarconvenio: p95 > 10 s durante 10 minutos",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"consultarconvenio\"",
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_MAX"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 10000,
        "duration": "600s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "combiner": "OR",
  "enabled": true,
  "alertStrategy": {
    "autoClose": "3600s"
  }
}
