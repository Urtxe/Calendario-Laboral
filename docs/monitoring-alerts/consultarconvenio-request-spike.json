{
  "displayName": "Balance Laboral - consultarConvenio request spike",
  "documentation": {
    "content": "Detecta mas de 100 requests en 1 hora en consultarConvenio. Para el trafico actual esperado, este umbral ayuda a descubrir abuso, automatizaciones, bucles de frontend o pruebas accidentales contra produccion.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "app": "balance-laboral",
    "service": "consultarconvenio",
    "severity": "warning",
    "managed_by": "repo"
  },
  "conditions": [
    {
      "displayName": "consultarconvenio: mas de 100 requests en 1 hora",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"consultarconvenio\"",
        "aggregations": [
          {
            "alignmentPeriod": "3600s",
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 100,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "combiner": "OR",
  "enabled": true,
  "alertStrategy": {
    "autoClose": "3600s"
  }
}
