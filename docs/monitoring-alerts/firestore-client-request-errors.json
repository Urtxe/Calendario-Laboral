{
  "displayName": "Balance Laboral - Firestore client request errors",
  "documentation": {
    "content": "Detecta 20 o mas respuestas UNAUTHENTICATED o INVALID_ARGUMENT de Firestore en 10 minutos por metodo API. Es una senal informativa de sesion o peticiones cliente malformadas, no una alerta critica de disponibilidad.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "app": "balance-laboral",
    "service": "firestore",
    "severity": "warning",
    "signal_class": "client_request",
    "managed_by": "repo"
  },
  "conditions": [
    {
      "displayName": "Firestore: 20 o mas errores de peticion cliente en 10 minutos por metodo API",
      "conditionThreshold": {
        "filter": "metric.type=\"firestore.googleapis.com/api/request_count\" resource.type=\"firestore.googleapis.com/Database\" metric.labels.response_code=one_of(\"UNAUTHENTICATED\", \"INVALID_ARGUMENT\")",
        "aggregations": [
          {
            "alignmentPeriod": "600s",
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": [
              "metric.labels.api_method"
            ]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 19,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "combiner": "OR",
  "enabled": true,
  "alertStrategy": {
    "autoClose": "3600s"
  }
}
