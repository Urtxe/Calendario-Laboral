{
  "displayName": "Balance Laboral - Firestore quota exhaustion",
  "documentation": {
    "content": "Detecta 3 o mas respuestas RESOURCE_EXHAUSTED de Firestore en 10 minutos por metodo API. Senala agotamiento de cuota o limitacion de recursos y se revisa separadamente de rechazos de reglas.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "app": "balance-laboral",
    "service": "firestore",
    "severity": "warning",
    "signal_class": "quota",
    "managed_by": "repo"
  },
  "conditions": [
    {
      "displayName": "Firestore: 3 o mas RESOURCE_EXHAUSTED en 10 minutos por metodo API",
      "conditionThreshold": {
        "filter": "metric.type=\"firestore.googleapis.com/api/request_count\" resource.type=\"firestore.googleapis.com/Database\" metric.labels.response_code=\"RESOURCE_EXHAUSTED\"",
        "aggregations": [
          {
            "alignmentPeriod": "600s",
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": [
              "metric.labels.api_method"
            ]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 2,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "combiner": "OR",
  "enabled": true,
  "alertStrategy": {
    "autoClose": "3600s"
  }
}
