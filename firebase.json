{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".git/**",
      ".firebase/**",
      ".tmp.driveupload/**",
      ".tmp.drivedownload/**",
      ".gitignore",
      "**/.env",
      "**/.env.*",
      "**/*.log",
      "**/node_modules/**",
      "firestore.rules",
      "firestore.indexes.json",
      ".firebaserc",
      "docs/**",
      "functions/**",
      "README.md",
      "Marketing/**"
    ],
    "rewrites": [
      {
        "source": "/webhook",
        "function": "stripeWebhook"
      },
      {
        "source": "/consultarConvenio",
        "function": "consultarConvenio"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/mensajeUsuarios",
        "destination": "/mensajeUsuarios.html"
      },
      {
        "source": "/convenios",
        "destination": "/seo/convenios.html"
      },
      {
        "source": "/convenios/hosteleria-gipuzkoa",
        "destination": "/seo/hosteleria-gipuzkoa.html"
      },
      {
        "source": "/convenios/alojamientos-gipuzkoa",
        "destination": "/seo/alojamientos-gipuzkoa.html"
      },
      {
        "source": "/convenios/hosteleria-bizkaia",
        "destination": "/seo/hosteleria-bizkaia.html"
      },
      {
        "source": "/convenios/hosteleria-madrid",
        "destination": "/seo/hosteleria-madrid.html"
      },
      {
        "source": "/convenios/alojamientos-alava",
        "destination": "/seo/alojamientos-alava.html"
      },
      {
        "source": "/convenios/alojamientos-sevilla",
        "destination": "/seo/alojamientos-sevilla.html"
      },
      {
        "source": "/convenios/alojamientos-zaragoza",
        "destination": "/seo/alojamientos-zaragoza.html"
      },
      {
        "source": "/convenios/limpieza-madrid",
        "destination": "/seo/limpieza-madrid.html"
      },
      {
        "source": "/convenios/limpieza-gipuzkoa",
        "destination": "/seo/limpieza-gipuzkoa.html"
      },
      {
        "source": "/convenios/limpieza-bizkaia",
        "destination": "/seo/limpieza-bizkaia.html"
      },
      {
        "source": "/convenios/transporte-madrid",
        "destination": "/seo/transporte-madrid.html"
      },
      {
        "source": "/convenios/transporte-valencia",
        "destination": "/seo/transporte-valencia.html"
      },
      {
        "source": "/convenios/transporte-sevilla",
        "destination": "/seo/transporte-sevilla.html"
      },
      {
        "source": "/convenios/alojamientos-barcelona",
        "destination": "/seo/alojamientos-barcelona.html"
      },
      {
        "source": "/convenios/alojamientos-navarra",
        "destination": "/seo/alojamientos-navarra.html"
      },
      {
        "source": "/convenios/hosteleria-malaga",
        "destination": "/seo/hosteleria-malaga.html"
      },
      {
        "source": "/convenios/hosteleria-valencia",
        "destination": "/seo/hosteleria-valencia.html"
      },
      {
        "source": "/convenios/limpieza-barcelona",
        "destination": "/seo/limpieza-barcelona.html"
      },
      {
        "source": "/convenios/limpieza-navarra",
        "destination": "/seo/limpieza-navarra.html"
      },
      {
        "source": "/convenios/limpieza-sevilla",
        "destination": "/seo/limpieza-sevilla.html"
      },
      {
        "source": "/convenios/limpieza-valencia",
        "destination": "/seo/limpieza-valencia.html"
      },
      {
        "source": "/convenios/limpieza-zaragoza",
        "destination": "/seo/limpieza-zaragoza.html"
      },
      {
        "source": "/convenios/transporte-alava",
        "destination": "/seo/transporte-alava.html"
      },
      {
        "source": "/convenios/transporte-barcelona",
        "destination": "/seo/transporte-barcelona.html"
      },
      {
        "source": "/convenios/transporte-bizkaia",
        "destination": "/seo/transporte-bizkaia.html"
      },
      {
        "source": "/convenios/transporte-gipuzkoa",
        "destination": "/seo/transporte-gipuzkoa.html"
      },
      {
        "source": "/convenios/transporte-navarra",
        "destination": "/seo/transporte-navarra.html"
      },
      {
        "source": "/convenios/transporte-zaragoza",
        "destination": "/seo/transporte-zaragoza.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-developer-merchantid-domain-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/mensajeUsuarios.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/src/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true
    }
  ]
}
