rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function esUsuario(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function cuentaActiva(uid) {
      return esUsuario(uid)
        && !exists(/databases/$(database)/documents/accountDeletions/$(uid));
    }

    function camposEditablesUsuario() {
      return [
        "email",
        "fechaRegistro",
        "ciudadActual",
        "sectorUsuario",
        "esHosteleria"
      ];
    }

    function camposReservadosUsuario() {
      return [
        "tipoCuenta",
        "stripeCustomerId",
        "subscriptionId",
        "subscriptionStatus",
        "billing",
        "billingStatus",
        "role",
        "admin",
        "isPremium",
        "premium",
        "createdAt",
        "updatedBillingAt",
        "stripeSubscriptionId",
        "stripePriceId",
        "stripeProductId",
        "stripeCurrentPeriodEnd",
        "stripeCancelAtPeriodEnd"
      ];
    }

    function camposPermitidosDocumentoUsuario() {
      return [
        "email",
        "fechaRegistro",
        "ciudadActual",
        "sectorUsuario",
        "esHosteleria",
        "tipoCuenta",
        "stripeCustomerId",
        "subscriptionId",
        "subscriptionStatus",
        "billing",
        "billingStatus",
        "role",
        "admin",
        "isPremium",
        "premium",
        "createdAt",
        "updatedBillingAt",
        "stripeSubscriptionId",
        "stripePriceId",
        "stripeProductId",
        "stripeCurrentPeriodEnd",
        "stripeCancelAtPeriodEnd"
      ];
    }

    function camposReservadosSinCambios() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(camposReservadosUsuario());
    }

    function camposEditablesValidos(data) {
      return (!data.keys().hasAny(["email"]) || data.email is string)
        && (!data.keys().hasAny(["fechaRegistro"]) || data.fechaRegistro is string)
        && (!data.keys().hasAny(["ciudadActual"]) || data.ciudadActual is string)
        && (!data.keys().hasAny(["sectorUsuario"]) || data.sectorUsuario is string)
        && (!data.keys().hasAny(["esHosteleria"]) || data.esHosteleria is bool);
    }
    
    // 1. REGLA PARA FESTIVOS (PÚBLICA)
    match /festivos_oficiales/{document=**} {
      allow read: if true;
    }

    // 2. REGLA PARA USUARIOS (PRIVADA)
    match /usuarios/{userId} {
      allow read: if cuentaActiva(userId);

      allow create: if cuentaActiva(userId)
        && request.resource.data.keys().hasOnly(camposEditablesUsuario())
        && camposEditablesValidos(request.resource.data);

      allow update: if cuentaActiva(userId)
        && request.resource.data.keys().hasOnly(camposPermitidosDocumentoUsuario())
        && camposReservadosSinCambios()
        && camposEditablesValidos(request.resource.data);

      allow delete: if false;

      match /years/{yearId} {
        allow read, write: if cuentaActiva(userId);

      }

      match /resumenes/{yearId} {
        allow read, write: if false;
      }

      match /visitas/{visitId} {
        allow read, write: if cuentaActiva(userId);
      }

      match /usage/{usageDoc} {
        allow read: if cuentaActiva(userId);
        allow write: if false;
      }

      match /{allSubcollections=**} {
        allow read, write: if false;
      }
    }

    // 3. Colección heredada: GA4 es la fuente de analítica y el cliente ya no
    // puede crear ni actualizar documentos de visitas individuales.
    match /visitasAnonimas/{docId} {
      allow read, write: if false;
    }

    // El marcador solo lo administra el backend; denegar acceso directo evita
    // exponer el tombstone pseudónimo o permitir que el cliente lo altere.
    match /accountDeletions/{uid} {
      allow read, write: if false;
    }

  } 
} 
